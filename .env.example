# Checkmate local configuration

CHECKMATE_APP_NAME=Checkmate Code Review System

# GitHub webhook security
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_secret
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

# Local Ollama AI reviewer
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=300

# Branch and review settings
CHECKMATE_ALLOWED_BRANCHES=main,develop,master
CHECKMATE_REVIEW_SCOPE=changed
CHECKMATE_REVIEW_TYPE=detail
CHECKMATE_LINE_LIMIT=120

# Public demo integration test
CHECKMATE_TEST_REPOSITORY=octocat/Hello-World
CHECKMATE_TEST_BRANCH=master
CHECKMATE_TEST_COMMIT=7fd1a60b01f91b314f59955a4e4d4e80d8edf11d
