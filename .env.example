# Checkmate local configuration. Copy this file to .env and edit it.
CHECKMATE_APP_NAME=Checkmate Code Review System
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_secret
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

# Ollama is installed on the office Windows laptop. The review client is
# the next milestone; these settings are included for that upcoming step.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=120

# Demo values: includes master so the public integration test below works.
# Change this to your team's required branch list once testing is complete.
CHECKMATE_ALLOWED_BRANCHES=main,develop,master
CHECKMATE_REVIEW_SCOPE=changed
CHECKMATE_REVIEW_TYPE=detail
CHECKMATE_LINE_LIMIT=120

# Public demo commit used by the local webhook-to-GitHub integration test.
CHECKMATE_TEST_REPOSITORY=octocat/Hello-World
CHECKMATE_TEST_BRANCH=master
CHECKMATE_TEST_COMMIT=7fd1a60b01f91b314f59955a4e4d4e80d8edf11d
